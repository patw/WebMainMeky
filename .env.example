# OpenAI-compatible endpoint used ONLY for rule authoring (never on the request path).
OPENAI_BASE_URL=http://127.0.0.1:8086/v1
OPENAI_API_KEY=doesntmatter
OPENAI_MODEL=local
OPENAI_TIMEOUT=120

# Where the moofile collections live (relative to the project root).
WMM_DATA_DIR=data

# Rule promotion policy
WMM_MIN_SUPPORT=3
WMM_MIN_CONFIDENCE=0.55

# Validation gate
WMM_MIN_CHARS=220
WMM_MIN_SENTENCES=3
WMM_MAX_LINK_DENSITY=0.55
